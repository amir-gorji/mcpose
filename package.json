{
  "name": "mcpose-monorepo",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "test": "turbo run test",
    "ts:ci": "turbo run ts:ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:publish": "pnpm -r --filter './packages/*' exec publint . && pnpm -r --filter './packages/*' exec attw --pack . --profile esm-only",
    "knip": "knip",
    "prepublishOnly": "echo 'Publish individual packages from packages/*'"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "turbo": "2.11.2",
    "typescript-eslint": "8.70.1"
  },
  "packageManager": "pnpm@11.0.8"
}
