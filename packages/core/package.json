{
  "name": "mcpose",
  "version": "3.0.0",
  "description": "The audit and governance layer for MCP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "middleware",
    "functional-programming",
    "proxy",
    "compose",
    "model-context-protocol",
    "audit",
    "compliance",
    "fintech"
  ],
  "author": "Amir Gorji",
  "license": "MIT",
  "homepage": "https://github.com/amir-gorji/mcpose#readme",
  "bugs": {
    "url": "https://github.com/amir-gorji/mcpose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-gorji/mcpose.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ts:ci": "tsc --noEmit",
    "test": "vitest run --coverage",
    "mutation": "stryker run",
    "prepublishOnly": "pnpm run ts:ci && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
