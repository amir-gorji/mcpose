{
  "name": "@mcpose/store-postgres",
  "version": "0.1.0",
  "description": "Postgres-backed EventStore for mcpose: durable, uncapped SSE reconnect replay",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "mcpose",
    "postgres",
    "eventstore",
    "sse",
    "resumability"
  ],
  "author": "Amir Gorji",
  "license": "MIT",
  "homepage": "https://github.com/amir-gorji/mcpose#readme",
  "bugs": {
    "url": "https://github.com/amir-gorji/mcpose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-gorji/mcpose.git",
    "directory": "packages/store-postgres"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ts:ci": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepublishOnly": "pnpm run ts:ci && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "pg": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
