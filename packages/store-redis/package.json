{
  "name": "@mcpose/store-redis",
  "version": "0.1.0",
  "description": "Redis-backed EventStore and SessionRegistry for mcpose: SSE reconnect replay that survives a restart",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "mcpose",
    "redis",
    "eventstore",
    "sse",
    "resumability",
    "session"
  ],
  "author": "Amir Gorji",
  "license": "MIT",
  "homepage": "https://github.com/amir-gorji/mcpose#readme",
  "bugs": {
    "url": "https://github.com/amir-gorji/mcpose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-gorji/mcpose.git",
    "directory": "packages/store-redis"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ts:ci": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepublishOnly": "pnpm run ts:ci && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "mcpose": ">=3.0.0 <4",
    "redis": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "5.0.1",
    "mcpose": "workspace:*",
    "redis": "^6.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
