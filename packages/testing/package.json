{
  "name": "@mcpose/testing",
  "version": "3.0.0",
  "description": "Compliance testing utilities for mcpose — audit chain, manifest, redaction, and delegation assertions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "testing",
    "compliance",
    "audit",
    "fintech"
  ],
  "author": "Amir Gorji",
  "license": "MIT",
  "homepage": "https://github.com/amir-gorji/mcpose#readme",
  "bugs": {
    "url": "https://github.com/amir-gorji/mcpose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir-gorji/mcpose.git",
    "directory": "packages/testing"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ts:ci": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run ts:ci && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "mcpose": ">=2.2.0 <4",
    "@mcpose/audit": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10",
    "mcpose": "workspace:*",
    "@mcpose/audit": "workspace:*"
  }
}
